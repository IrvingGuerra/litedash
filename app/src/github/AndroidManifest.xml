<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Solo la versión de GitHub: buscar y bajar versiones nuevas de LiteDash cuando
        el usuario toca "Buscar actualizaciones", e instalarlas con su confirmación.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver
            android:name="com.irvingguerra.litedash.feature.updater.InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
