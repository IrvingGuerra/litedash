<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Apps a la vista sin el permiso restringido QUERY_ALL_PACKAGES (el cajón declara las suyas). -->
    <queries>
        <!-- Botón de voz: el asistente que tenga la pantalla. -->
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
        <!-- Qué launchers hay y cuál es el predeterminado (solo para los reportes). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Apps de navegación instaladas (Ajustes → Apps → Navegación): las que abren una dirección o son de mapas. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <!-- Atajos a Ajustes de Android (Sistema): solo los que la pantalla tiene. -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.LOCATION_SOURCE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DISPLAY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SOUND_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.LOCALE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
    </queries>

    <!-- "Abrir LiteDash al encender" (apagado de fábrica): saber que la pantalla encendió y, desde
         Android 10, poder ponerse al frente sola ("Mostrar sobre otras apps", lo da el usuario). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Regresar al inicio tras abrir encima una app de música o de fábrica (permiso normal, sin pregunta). -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Catálogo de autos, actualizaciones (GitHub), clima, mapa, radio por internet, carátulas,
         estadísticas anónimas (apagables), "Enviar un reporte" y el escáner OBD por Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ícono de Wi-Fi o datos en la barra (permiso normal, sin pregunta). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Clima y tema por el sol: solo la ubicación aproximada, y solo si lo activas. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Viaje (velocímetro): GPS, solo si agregas la pieza y mientras se ve. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Escáner OBD por cable USB (opcional: también va por Bluetooth o Wi-Fi). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- «Hacer visible esta pantalla» (Vincular celular) en Android 12+: abre la ventana de Android de 5 minutos.
         Solo existe desde Android 12 y nunca tiene que ver con la ubicación (no lleva maxSdkVersion ni neverForLocation). -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Brillo de día y noche en todas las apps: solo si lo activas (Android lo pide aparte). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <application
        android:name=".LiteDashApp"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:theme="@style/Theme.LiteDash">

        <!-- Para medir con Macrobenchmark y adb en compilaciones release/benchmark. -->
        <profileable android:shell="true" tools:targetApi="29" />

        <!-- Sin EmojiCompat (lo trae Compose): LiteDash no usa emoji de compatibilidad y así no busca la fuente de
             emoji en cada arranque. Los demás inicializadores de androidx.startup se quedan. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <!-- El auto solo, para la mitad de la pantalla dividida (en su propia tarea: el inicio no puede ser una mitad). -->
        <activity
            android:name=".SplitActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.split"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode" />
        <activity
            android:name=".SplitStartActivity"
            android:exported="false"
            android:taskAffinity="${applicationId}.split_start"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!--
            Receptor de llantas o cable OBD conectado: Android ofrece "usar siempre LiteDash" y el
            permiso queda dado (no se pide en cada encendido). Sin pantalla y en su propia tarea:
            no toca el inicio ni lo trae al frente. Apagada de fábrica: LiteDashApp la prende solo
            con llantas por USB o un cable OBD USB guardado (UsbAttachActivity.offer).
        -->
        <activity
            android:name="com.irvingguerra.litedash.feature.tpms.UsbAttachActivity"
            android:enabled="false"
            android:exported="true"
            android:taskAffinity="${applicationId}.usb"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_devices" />
        </activity>

        <!-- Apagado: solo se prende con "Abrir LiteDash al encender" (BootLaunch.sync). -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.ACTION_BOOT_IPO" />
                <action android:name="com.fyt.boot.ACCON" />
                <action android:name="com.glsx.boot.ACCON" />
                <action android:name="com.cayboy.action.ACC_ON" />
                <action android:name="com.carboy.action.ACC_ON" />
                <action android:name="com.qf.action.ACC_ON" />
                <action android:name="autochips.intent.action.QB_POWERON" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lugares compartidos desde otras apps (WhatsApp, un navegador…): el mapa de LiteDash los enseña. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>
    </application>
</manifest>
