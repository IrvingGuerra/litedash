<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Apps a la vista sin el permiso restringido QUERY_ALL_PACKAGES (el cajón declara las suyas). -->
    <queries>
        <!-- Botón de voz: el asistente que tenga la pantalla. -->
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
    </queries>

    <!-- Solo para bajar el catálogo de autos (imágenes) cuando el usuario lo abre. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ícono de Wi-Fi o datos en la barra (permiso normal, sin pregunta). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Clima y tema por el sol: solo la ubicación aproximada, y solo si lo activas. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Viaje (velocímetro): GPS, solo si agregas la pieza y mientras se ve. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Escáner OBD por cable USB (opcional: también va por Bluetooth o Wi-Fi). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Brillo de día y noche en todas las apps: solo si lo activas (Android lo pide aparte). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <application
        android:name=".LiteDashApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:theme="@style/Theme.LiteDash">

        <!-- Para medir con Macrobenchmark y adb en compilaciones release/benchmark. -->
        <profileable android:shell="true" tools:targetApi="29" />

        <!-- El auto solo, para la mitad de la pantalla dividida (en su propia tarea: el inicio no puede ser una mitad). -->
        <activity
            android:name=".SplitActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.dividida"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode" />
        <activity
            android:name=".SplitStartActivity"
            android:exported="false"
            android:taskAffinity="${applicationId}.dividir"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
