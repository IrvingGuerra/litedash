<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o más: igual que backup_rules.xml, en el respaldo de la nube y al pasar a otro equipo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="estadisticas.xml" />
        <exclude domain="sharedpref" path="stats.xml" />
        <exclude domain="file" path="map_vector/" />
        <exclude domain="file" path="map_offline/" />
        <exclude domain="file" path="map_packs/" />
        <exclude domain="file" path="cars/" />
        <exclude domain="sharedpref" path="cars.xml" />
        <exclude domain="sharedpref" path="pro.xml" />
        <exclude domain="sharedpref" path="link.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="estadisticas.xml" />
        <exclude domain="sharedpref" path="stats.xml" />
        <exclude domain="file" path="map_vector/" />
        <exclude domain="file" path="map_offline/" />
        <exclude domain="file" path="map_packs/" />
        <exclude domain="file" path="cars/" />
        <exclude domain="sharedpref" path="cars.xml" />
        <exclude domain="sharedpref" path="pro.xml" />
        <exclude domain="sharedpref" path="link.xml" />
    </device-transfer>
</data-extraction-rules>
