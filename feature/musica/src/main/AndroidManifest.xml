<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Para saber qué apps de música hay instaladas (las que ofrecen su biblioteca). -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>
    <application>
        <!--
            Existe para que el usuario pueda dar "acceso a notificaciones": con
            ese permiso Android deja leer qué suena en otras apps. De los avisos
            solo se mira el de la app de navegación (la siguiente vuelta); no se
            guarda nada.
        -->
        <service
            android:name=".ServicioMusica"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
