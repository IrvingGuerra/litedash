<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Reproductor propio: USB (siempre) y radio por internet (opcional, en Ajustes → Apps → Radio). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Sigue sonando con otra app encima: servicio en primer plano con su aviso. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para saber si la pantalla trae el selector de carpetas de Android (si no, el explorador propio). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
    </queries>
    <application>
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
