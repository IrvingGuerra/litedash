{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "site",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "firestore.rules"
    ],
    "headers": [
      {
        "source": "/wallpapers/index.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/audio/recipes.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.@(webp|png|jpg|svg|ico|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/connect/eliminar-cuenta{,/**}",
        "destination": "/connect/delete-account/",
        "type": 301
      },
      {
        "source": "/connect/privacidad{,/,.html}",
        "destination": "/connect/privacy/",
        "type": 301
      }
    ]
  }
}
