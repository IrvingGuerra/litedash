{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "firebase-redirect",
    "ignore": [
      "**/.*"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://litedash.dev/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://litedash.dev/:path",
        "type": 301
      }
    ]
  }
}
